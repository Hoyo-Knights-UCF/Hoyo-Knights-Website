.events {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
    max-width: 1200px;
    margin: auto;
    padding: 40px;
}

.event-card {
    display: block;
    text-decoration: none;
    color: #a9def9;
    background: #5A2576;
    border-radius: 15px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.event-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
}

nav a {
  display: inline-block;
  padding: 10px 20px;
